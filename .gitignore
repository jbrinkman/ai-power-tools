.DS_Store

# aim auto-injects .kiro/agents/*.json into kiro-cli agent configs on every
# launch; this project uses no AWS creds via aim and doesn't want that churn
# version-controlled. Scoped to the repo ROOT .kiro/ only — the eval harness's
# hand-authored workspace agent under evals/.kiro/agents is tracked (it wires
# the mock builder-mcp server and must be reproducible).
/.kiro/

# Scratch/debug output that should never land at repo root (evals/ has its
# own scoped tmp/ already gitignored under evals/.gitignore).
/tmp/

